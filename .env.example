# Copy to .env.local for local development, and set the same variable
# in Vercel → Project → Settings → Environment Variables for production.
#
# Used for canonical URLs, Open Graph tags, sitemap.xml and JSON-LD.
#
# Optional on Vercel: if this is unset (or left empty), the site falls back
# to Vercel's own VERCEL_PROJECT_PRODUCTION_URL, then to the preview
# deployment URL, then to http://localhost:3000. Set it once you have a
# custom domain so canonical URLs point at the domain you want indexed.
#
# A trailing slash, surrounding quotes or a missing https:// are all
# tolerated and normalised.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
